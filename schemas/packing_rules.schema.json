{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "packing_rules.json",
  "description": "打包清單規則。列舉值必須與 App 的 Swift enum rawValue 一致，否則規則會靜默失效。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["layer", "reasonZh", "items"],
    "properties": {
      "layer": { "enum": ["base", "culture", "weather", "party", "experience", "age", "gender"] },
      "reasonZh": { "type": "string", "minLength": 1 },
      "match": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "countries": { "$ref": "#/$defs/uniqueList", "items": { "type": "string", "pattern": "^[A-Z]{2}$" } },
          "months": { "$ref": "#/$defs/uniqueList", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
          "weatherTags": { "$ref": "#/$defs/uniqueList", "items": { "enum": ["rain", "hot", "cold", "mild"] } },
          "parties": { "$ref": "#/$defs/uniqueList", "items": { "enum": ["solo", "couple", "friends", "family", "colleagues"] } },
          "experiences": { "$ref": "#/$defs/uniqueList", "items": { "enum": ["first", "some", "frequent"] } },
          "ageBands": { "$ref": "#/$defs/uniqueList", "items": { "enum": ["teen", "young", "adult", "middle", "senior"] } },
          "genders": { "$ref": "#/$defs/uniqueList", "items": { "enum": ["male", "female", "undisclosed"] } }
        }
      },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nameZh", "category"],
          "properties": {
            "nameZh": { "type": "string", "minLength": 1 },
            "category": { "enum": ["clothing", "electronics", "documents", "toiletries", "health", "other"] },
            "quantity": { "type": "integer", "minimum": 1 },
            "perDay": { "type": "boolean" },
            "fullOnly": { "type": "boolean" }
          }
        }
      }
    }
  },
  "$defs": {
    "uniqueList": { "type": "array", "uniqueItems": true }
  }
}
