{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "packing_rules.json",
  "description": "對應 StaticDataStore.swift 的 PackingRule / TagCondition。物品由 packing_items.json 目錄解析。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "reasonZh", "needs"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "when": { "$ref": "#/$defs/condition" },
      "reasonZh": { "type": "string", "minLength": 1 },
      "needs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["itemId"] },
            { "required": ["need"] }
          ],
          "properties": {
            "itemId": { "type": "string", "minLength": 1 },
            "need": { "type": "string", "minLength": 1 },
            "quantity": { "type": "integer", "minimum": 1 },
            "perDay": { "type": "boolean" },
            "when": { "$ref": "#/$defs/condition" }
          }
        }
      }
    }
  },
  "$defs": {
    "condition": {
      "description": "all / any / none 與 Swift 集合代數一致；空物件代表永遠成立。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "$ref": "#/$defs/tags" },
        "any": { "$ref": "#/$defs/tags" },
        "none": { "$ref": "#/$defs/tags" }
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
