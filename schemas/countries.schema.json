{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "countries.json",
  "description": "國家參考資料。自動欄位由 scripts/fetch_reference.py 產生，其餘為人工策展。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["code", "nameZh", "nameEn", "currencyCode", "languageCode", "emergency", "plugTypes", "voltage", "sourceUrl"],
    "properties": {
      "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "nameZh": { "type": "string", "minLength": 1 },
      "nameEn": { "type": "string", "minLength": 1 },
      "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
      "languageCode": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?$" },
      "emergency": {
        "type": "object",
        "additionalProperties": false,
        "required": ["police", "ambulance", "fire"],
        "properties": {
          "police": { "$ref": "#/$defs/phone" },
          "ambulance": { "$ref": "#/$defs/phone" },
          "fire": { "$ref": "#/$defs/phone" }
        }
      },
      "plugTypes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-O]$" }
      },
      "voltage": { "type": "string", "pattern": "^[0-9]{3}V$" },
      "sourceUrl": { "type": "string", "pattern": "^https://" }
    }
  },
  "$defs": {
    "phone": { "type": "string", "pattern": "^[0-9]{2,4}$" }
  }
}
