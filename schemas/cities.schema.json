{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cities.json",
  "description": "城市參考資料。座標與 sourceUrl 由 scripts/fetch_reference.py 從 GeoNames 產生。",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["countryCode", "cityZh", "lat", "lon", "isDefault", "sourceUrl"],
    "properties": {
      "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "cityZh": { "type": "string", "minLength": 1 },
      "lat": { "type": "number", "minimum": -90, "maximum": 90 },
      "lon": { "type": "number", "minimum": -180, "maximum": 180 },
      "isDefault": { "type": "boolean" },
      "sourceUrl": { "type": "string", "pattern": "^https://www\\.geonames\\.org/[0-9]+$" }
    }
  }
}
