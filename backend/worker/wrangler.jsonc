{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "packsmart",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 參考資料：public/ 由 scripts/sync-reference.mjs 從 SeedData 產生，對應 App 的
  // PackSmartReferenceDataBaseURL = https://<worker>/reference/v1。靜態檔案請求免費且不限量，
  // 自帶 ETag／304，部署時整包原子切換。
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  // AI 冷知識的結果快取與每日上限計數。建立方式見 README。
  "kv_namespaces": [
    { "binding": "TRIVIA", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    // 每天（UTC）最多實際呼叫 Anthropic 幾次；快取命中不計。
    "DAILY_GENERATION_LIMIT": "50"
  },
  "observability": { "enabled": true }
}
