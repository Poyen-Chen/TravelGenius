<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- WeatherKit adapter is inactive (PD-035). Enable its entitlement only
         with a provisioned Developer Team when switching activeProvider. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.example.TravelGenius</string>
	</array>
</dict>
</plist>
